GEMINI_API_KEY=
# Keep runtime writes outside the source tree when using uvicorn --reload.
# FIXFLOW_WORKSPACE_ROOT=C:/path/to/fixflow-workspaces
GEMINI_MODEL_PRIMARY=gemini-3.7-flash
GEMINI_MODEL_FALLBACK=
GEMINI_TIMEOUT_SECONDS=120

# Single-file AI repair provider (Gemini remains the fallback)
INCEPTION_API_KEY=
FIXFLOW_FIX_MODEL=mercury-2
FIXFLOW_FIX_PROVIDER=mercury
FIXFLOW_FIX_TIMEOUT_SECONDS=6

# Single-file analyzer limits
MAX_FILE_UPLOAD_BYTES=1000000
FILE_WORKSPACE_TTL_SECONDS=900

# Optional execution limits
CLONE_TIMEOUT_SECONDS=90
DOCKER_INFO_TIMEOUT_SECONDS=10
DOCKER_PULL_TIMEOUT_SECONDS=180
DOCKER_BUILD_TIMEOUT_SECONDS=600
DOCKER_RUN_TIMEOUT_SECONDS=300
DOCKER_MEMORY=1g
DOCKER_CPUS=1.0
DOCKER_PIDS_LIMIT=256
